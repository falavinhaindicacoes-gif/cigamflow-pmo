{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "access_profile_id": {
      "type": "string",
      "description": "ID do perfil de acesso atribu\u00eddo ao usu\u00e1rio"
    },
    "paginas_override": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Override individual: lista de slugs de p\u00e1ginas permitidas (substitui o perfil se preenchido)",
      "default": []
    }
  }
}