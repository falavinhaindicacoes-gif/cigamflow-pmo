{
  "name": "Consultant",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "especialidade_principal": {
      "type": "string",
      "enum": [
        "financeiro",
        "contabil",
        "fiscal",
        "estoque",
        "compras",
        "vendas",
        "producao",
        "rh",
        "ti",
        "integracao",
        "customizacao",
        "geral"
      ]
    },
    "modulos_habilitados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de m\u00f3dulos/especialidades que o consultor est\u00e1 habilitado a atuar"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "ferias",
        "afastado"
      ],
      "default": "ativo"
    },
    "gestor": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}