{
  "name": "ProjectModule",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "template_module_id": {
      "type": "string",
      "description": "Refer\u00eancia ao m\u00f3dulo de template de origem (opcional)"
    },
    "name": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciado",
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "default": "nao_iniciado"
    },
    "ordem": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}