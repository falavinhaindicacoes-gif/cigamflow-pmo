{
  "name": "ModuleSubItem",
  "type": "object",
  "properties": {
    "module_item_id": {
      "type": "string",
      "description": "ID do ModuleItem pai"
    },
    "project_module_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Nome do sub-item"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciado",
        "em_andamento",
        "aguardando_confirmacao",
        "concluido",
        "cancelado"
      ],
      "default": "nao_iniciado",
      "description": "Status do sub-item"
    },
    "ordem": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "module_item_id",
    "name"
  ]
}