{
  "name": "Allocation",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "consultant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "papel_no_projeto": {
      "type": "string"
    },
    "especialidade_aplicada": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data espec\u00edfica da aloca\u00e7\u00e3o"
    },
    "periodo_do_dia": {
      "type": "string",
      "enum": [
        "manha",
        "tarde",
        "noite"
      ],
      "description": "Turno da aloca\u00e7\u00e3o"
    },
    "tipo_agenda": {
      "type": "string",
      "enum": [
        "projeto_modulos",
        "atividades_avulsas",
        "outros"
      ],
      "default": "projeto_modulos",
      "description": "Prop\u00f3sito da agenda: m\u00f3dulos do projeto, atividades avulsas ou outro"
    },
    "activity_id": {
      "type": "string",
      "description": "ID da Activity vinculada quando tipo_agenda = atividades_avulsas"
    },
    "status_faturamento": {
      "type": "string",
      "enum": [
        "faturado",
        "a_confirmar",
        "nao_faturado"
      ],
      "default": "a_confirmar",
      "description": "Status de faturamento da agenda"
    },
    "horas_semanais": {
      "type": "number",
      "default": 0
    },
    "horas_mensais": {
      "type": "number",
      "default": 0
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "encerrada",
        "pausada",
        "planejada"
      ],
      "default": "ativa"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "consultant_id",
    "data",
    "periodo_do_dia"
  ]
}